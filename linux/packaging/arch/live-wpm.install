_note() {
    if ! systemctl is-enabled -q live-wpm-keys.socket 2>/dev/null; then
        echo ">>> Live WPM's keyboard service reads the keyboard for it, locked down by systemd"
        echo ">>> (no network, no access to your files; your own account needs no extra rights)."
        echo ">>> Switch it on once:"
        echo ">>>     sudo systemctl enable --now live-wpm-keys.socket"
    fi
}

post_install() { _note; }
post_upgrade() { _note; }

pre_remove() {
    systemctl disable --now live-wpm-keys.socket live-wpm-keys.service >/dev/null 2>&1 || true
}
