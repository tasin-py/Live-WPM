[Unit]
Description=Live WPM keyboard service (socket)
Documentation=https://github.com/tasin-py/Live-WPM#linux

[Socket]
# Anyone may connect, but the service answers only the user logged in at the screen
# (it checks each caller's user id against systemd-logind's active local sessions).
ListenStream=/run/live-wpm/keys.sock
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
