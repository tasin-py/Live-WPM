[Unit]
Description=Live WPM keyboard service (tells Live WPM the kind of each key, never which key)
Documentation=https://github.com/tasin-py/Live-WPM#linux
Requires=live-wpm-keys.socket

[Service]
# Started on demand by live-wpm-keys.socket; reads keyboards only while Live WPM is connected,
# and exits by itself after 30 quiet seconds. The code is linux/KeyboardService.cs.
ExecStart=/usr/lib/live-wpm/live-wpm --keyboard-service

# Its own temporary user, created when it starts and gone when it stops, allowed to read input devices.
# No account is added to your system, and your own account gets no extra rights.
DynamicUser=yes
SupplementaryGroups=input
CacheDirectory=live-wpm-keys
Environment=HOME=%C/live-wpm-keys DOTNET_BUNDLE_EXTRACT_BASE_DIR=%C/live-wpm-keys DOTNET_EnableDiagnostics=0 DOTNET_CLI_TELEMETRY_OPTOUT=1

# No network of any kind: it can't send anything anywhere.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

# Only input devices; the rest of the system is read-only, and home folders are invisible.
DevicePolicy=closed
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# No privileges, and nothing it could use to get any.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
